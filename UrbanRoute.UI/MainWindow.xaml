<Window x:Class="UrbanRoute.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UrbanRoute - Red de transporte urbano"
        Width="1180" Height="730"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#080D17"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <!-- Estilo de los botones del menú lateral. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9D6E7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#284263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo del botón principal azul. -->
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#2865E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#3978FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de los selectores de paradas. -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="#29394F"/>
            <Setter Property="Foreground" Value="#0D1827"/>
            <Setter Property="BorderBrush" Value="#3B506C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,7,0,14"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#0D1827"/>
                        <Setter Property="Padding" Value="8,6"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- DISTRIBUCIÓN PRINCIPAL -->
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL LATERAL IZQUIERDO -->
        <Border Grid.Column="0"
                Background="#131F30"
                CornerRadius="17"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logotipo y nombre -->
                <StackPanel Orientation="Horizontal"
                            Margin="1,6,0,30">

                    <Border Width="40" Height="40"
                            Background="#2563EB"
                            CornerRadius="10">
                        <TextBlock Text="▣"
                                   Foreground="White"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="10,2,0,0">
                        <TextBlock Text="UrbanRoute"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Red de transporte"
                                   FontSize="10"
                                   Foreground="#94A8C4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Opciones de navegación -->
                <StackPanel Grid.Row="1">

                    <TextBlock Text="NAVEGACIÓN"
                               Foreground="#7890AE"
                               FontSize="11"
                               Margin="10,0,0,12"/>

                    <Button x:Name="BtnInicio"
                            Content="Vista general"
                            Tag="Inicio"
                            Style="{StaticResource NavButton}"
                            Background="#224273"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnParadas"
                            Content="Paradas"
                            Tag="Paradas"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnConexiones"
                            Content="Conexiones"
                            Tag="Conexiones"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnRecorridos"
                            Content="Recorridos BFS / DFS"
                            Tag="Recorridos"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnRutas"
                            Content="Rutas más rápidas"
                            Tag="Rutas"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnTrie"
                            Content="Autocompletado"
                            Tag="Autocompletado"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnPruebas"
                            Content="Pruebas Tabla Hash"
                            Tag="Pruebas"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>
                </StackPanel>

                <!-- Botón Salir -->
                <StackPanel Grid.Row="2">
                    <Border Height="1"
                            Background="#2D3D54"
                            Margin="2,0,2,10"/>

                    <Button Content="Salir del sistema"
                            Style="{StaticResource NavButton}"
                            Click="Salir_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Border Grid.Column="1"
                Margin="14,0,0,0"
                Background="#101A2A"
                CornerRadius="17"
                Padding="22">

            <Grid>

                <!-- PANTALLA INICIO -->
                <Grid x:Name="DashboardView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <StackPanel Margin="0,1,0,18">
                        <TextBlock Text="Panel de control"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="25"/>

                        <TextBlock
                            Text="Gestión y visualización de la red de transporte urbano"
                            Foreground="#93A7C2"
                            FontSize="12"
                            Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- TARJETAS DE ESTADÍSTICAS -->
                    <Grid Grid.Row="1"
                          Height="95"
                          Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cantidad de paradas -->
                        <Border Grid.Column="0"
                                Background="#1C2B40"
                                CornerRadius="12"
                                Padding="17"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Paradas registradas"
                                           Foreground="#9BB0CD"
                                           FontSize="12"/>

                                <TextBlock x:Name="TxtCantidadParadas"
                                           Text="—"
                                           Foreground="White"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Estructuras -->
                        <Border Grid.Column="1"
                                Background="#1C2B40"
                                CornerRadius="12"
                                Padding="17"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Estructuras"
                                           Foreground="#9BB0CD"
                                           FontSize="12"/>

                                <TextBlock Text="Hash · Grafo"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Conectividad -->
                        <Border Grid.Column="2"
                                Background="#1C2B40"
                                CornerRadius="12"
                                Padding="17">
                            <StackPanel>
                                <TextBlock Text="Conectividad"
                                           Foreground="#9BB0CD"
                                           FontSize="12"/>

                                <TextBlock Text="Union-Find"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ZONA INFERIOR -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- VISUALIZACIÓN DEL GRAFO -->
                        <Border Grid.Column="0"
                                Background="#1B2A3F"
                                CornerRadius="13"
                                Padding="17"
                                Margin="0,0,12,0">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock
                                        Text="Visualización del grafo"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="White"/>

                                    <TextBlock
                                        Text="Ejemplo con los 6 nodos del esquema"
                                        Foreground="#96ABC8"
                                        FontSize="11"
                                        Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Grafo ilustrativo basado en el esquema -->
                                <Viewbox Grid.Row="1"
                                         Stretch="Uniform"
                                         Margin="0,10,0,8">

                                    <Canvas Width="570" Height="350">

                                        <!-- Conexiones -->
                                        <Line X1="106" Y1="126" X2="226" Y2="191"
                                              Stroke="#59A8F8" StrokeThickness="3"/>

                                        <Line X1="226" Y1="191" X2="366" Y2="141"
                                              Stroke="#59A8F8" StrokeThickness="3"/>

                                        <Line X1="366" Y1="141" X2="506" Y2="181"
                                              Stroke="#59A8F8" StrokeThickness="3"/>

                                        <Line X1="226" Y1="191" X2="256" Y2="291"
                                              Stroke="#59A8F8" StrokeThickness="3"/>

                                        <Line X1="256" Y1="291" X2="396" Y2="276"
                                              Stroke="#59A8F8" StrokeThickness="3"/>

                                        <Line X1="366" Y1="141" X2="396" Y2="276"
                                              Stroke="#59A8F8" StrokeThickness="3"/>

                                        <Line X1="396" Y1="276" X2="506" Y2="181"
                                              Stroke="#59A8F8" StrokeThickness="3"/>

                                        <!-- Nodo 6 -->
                                        <Border Canvas.Left="77" Canvas.Top="97"
                                                Width="58" Height="58"
                                                Background="#253E5B"
                                                BorderBrush="#60A5FA"
                                                BorderThickness="2"
                                                CornerRadius="29">
                                            <TextBlock Text="6"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nodo 4 -->
                                        <Border Canvas.Left="197" Canvas.Top="162"
                                                Width="58" Height="58"
                                                Background="#253E5B"
                                                BorderBrush="#60A5FA"
                                                BorderThickness="2"
                                                CornerRadius="29">
                                            <TextBlock Text="4"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nodo 5 -->
                                        <Border Canvas.Left="337" Canvas.Top="112"
                                                Width="58" Height="58"
                                                Background="#253E5B"
                                                BorderBrush="#60A5FA"
                                                BorderThickness="2"
                                                CornerRadius="29">
                                            <TextBlock Text="5"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nodo 1 -->
                                        <Border Canvas.Left="477" Canvas.Top="152"
                                                Width="58" Height="58"
                                                Background="#253E5B"
                                                BorderBrush="#60A5FA"
                                                BorderThickness="2"
                                                CornerRadius="29">
                                            <TextBlock Text="1"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nodo 3 -->
                                        <Border Canvas.Left="227" Canvas.Top="262"
                                                Width="58" Height="58"
                                                Background="#253E5B"
                                                BorderBrush="#60A5FA"
                                                BorderThickness="2"
                                                CornerRadius="29">
                                            <TextBlock Text="3"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nodo 2 -->
                                        <Border Canvas.Left="367" Canvas.Top="247"
                                                Width="58" Height="58"
                                                Background="#253E5B"
                                                BorderBrush="#60A5FA"
                                                BorderThickness="2"
                                                CornerRadius="29">
                                            <TextBlock Text="2"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                    </Canvas>
                                </Viewbox>

                                <TextBlock Grid.Row="2"
                                           Text="Las conexiones se dibujan según el Grafo."
                                           Foreground="#91A6C4"
                                           FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- PANEL CALCULAR RUTA -->
                        <Border Grid.Column="1"
                                Background="#1B2A3F"
                                CornerRadius="13"
                                Padding="17">

                            <StackPanel>
                                <TextBlock Text="Calcular ruta"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,18"/>

                                <TextBlock Text="Parada de origen"
                                           Foreground="#BCCDE1"
                                           FontSize="12"/>

                                <ComboBox x:Name="CmbOrigen"
                                          Style="{StaticResource DarkCombo}"/>

                                <TextBlock Text="Parada de destino"
                                           Foreground="#BCCDE1"
                                           FontSize="12"/>

                                <ComboBox x:Name="CmbDestino"
                                          Style="{StaticResource DarkCombo}"/>

                                <TextBlock Text="Criterio de optimización"
                                           Foreground="#BCCDE1"
                                           FontSize="12"
                                           Margin="0,4,0,9"/>

                                <!-- Tiempo o costo -->
                                <Grid Margin="0,0,0,17">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnTiempo"
                                            Grid.Column="0"
                                            Content="Tiempo"
                                            Tag="Tiempo"
                                            Background="#2865E8"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Height="39"
                                            Margin="0,0,5,0"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="Criterio_Click"/>

                                    <Button x:Name="BtnCosto"
                                            Grid.Column="1"
                                            Content="Costo"
                                            Tag="Costo"
                                            Background="#29394F"
                                            Foreground="#DAE4F2"
                                            BorderThickness="0"
                                            Height="39"
                                            Margin="5,0,0,0"
                                            Cursor="Hand"
                                            Click="Criterio_Click"/>
                                </Grid>

                                <Button Content="Calcular ruta"
                                        Style="{StaticResource BlueButton}"
                                        Click="CalcularRuta_Click"/>

                                <TextBlock x:Name="TxtResultado"
                                           Text="Resultado: pendiente"
                                           TextWrapping="Wrap"
                                           Foreground="#9FB5D0"
                                           FontSize="12"
                                           Margin="0,19,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- SECCIONES DEL MENÚ LATERAL -->
                <Grid x:Name="SeccionView"
                      Visibility="Collapsed">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="560">

                        <Border Width="74"
                                Height="74"
                                Background="#1D3A60"
                                CornerRadius="18"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,22">

                            <TextBlock Text="▤"
                                       Foreground="#7DB8FF"
                                       FontSize="41"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="TxtSeccionTitulo"
                                   Text="Sección"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>

                        <TextBlock x:Name="TxtSeccionDescripcion"
                                   Text="Esta sección se conectará con las estructuras del proyecto."
                                   Foreground="#AABBD0"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0"/>

                        <TextBlock
                            Text="Diseño base preparado. La funcionalidad se implementará en el siguiente paso."
                            Foreground="#7191B6"
                            FontSize="12"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Margin="0,17,0,0"/>

                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
