<Window x:Class="UrbanRoute.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:UrbanRoute.UI.Controls"
        Title="UrbanRoute - Red de transporte urbano"
        Width="1180" Height="730"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#080D17"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <!-- BOTONES DEL PANEL LATERAL -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9D6E7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#284263"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#2865E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#3978FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SELECTORES -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="#29394F"/>
            <Setter Property="Foreground" Value="#0D1827"/>
            <Setter Property="BorderBrush" Value="#3B506C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,7,0,14"/>
        </Style>

    </Window.Resources>

    <!-- VENTANA PRINCIPAL -->
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL LATERAL -->
        <Border Grid.Column="0"
                Background="#131F30"
                CornerRadius="17"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGOTIPO -->
                <StackPanel Orientation="Horizontal"
                            Margin="1,6,0,30">
                    <Border Width="40" Height="40"
                            Background="#2563EB"
                            CornerRadius="10">
                        <TextBlock Text="▣"
                                   Foreground="White"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="10,2,0,0">
                        <TextBlock Text="UrbanRoute"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Red de transporte"
                                   FontSize="10"
                                   Foreground="#94A8C4"/>
                    </StackPanel>
                </StackPanel>

                <!-- NAVEGACIÓN -->
                <StackPanel Grid.Row="1">

                    <TextBlock Text="NAVEGACIÓN"
                               Foreground="#7890AE"
                               FontSize="11"
                               Margin="10,0,0,12"/>

                    <Button x:Name="BtnInicio"
                            Content="Vista general"
                            Tag="Inicio"
                            Style="{StaticResource NavButton}"
                            Background="#224273"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnParadas"
                            Content="Paradas"
                            Tag="Paradas"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnConexiones"
                            Content="Conexiones"
                            Tag="Conexiones"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnRecorridos"
                            Content="Recorridos BFS / DFS"
                            Tag="Recorridos"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnRutas"
                            Content="Rutas más rápidas"
                            Tag="Rutas"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnTrie"
                            Content="Autocompletado"
                            Tag="Autocompletado"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>

                    <Button x:Name="BtnPruebas"
                            Content="Pruebas Tabla Hash"
                            Tag="Pruebas"
                            Style="{StaticResource NavButton}"
                            Click="Navegacion_Click"/>
                </StackPanel>

                <!-- SALIR -->
                <StackPanel Grid.Row="2">
                    <Border Height="1"
                            Background="#2D3D54"
                            Margin="2,0,2,10"/>
                    <Button Content="Salir del sistema"
                            Style="{StaticResource NavButton}"
                            Click="Salir_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Border Grid.Column="1"
                Margin="14,0,0,0"
                Background="#101A2A"
                CornerRadius="17"
                Padding="22">

            <Grid>

                <!-- DASHBOARD -->
                <Grid x:Name="DashboardView">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ENCABEZADO -->
                    <StackPanel Grid.Row="0"
                                Margin="0,1,0,18">
                        <TextBlock Text="Panel de control"
                                   FontSize="25"
                                   FontWeight="Bold"/>
                        <TextBlock
                            Text="Gestión y visualización de la red de transporte urbano"
                            Foreground="#93A7C2"
                            FontSize="12"
                            Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- TARJETAS -->
                    <Grid Grid.Row="1"
                          Height="95"
                          Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- PARADAS -->
                        <Border Grid.Column="0"
                                Background="#1C2B40"
                                CornerRadius="12"
                                Padding="17"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Paradas registradas"
                                           Foreground="#9BB0CD"
                                           FontSize="12"/>
                                <TextBlock x:Name="TxtCantidadParadas"
                                           Text="—"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ESTRUCTURAS -->
                        <Border Grid.Column="1"
                                Background="#1C2B40"
                                CornerRadius="12"
                                Padding="17"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Estructuras"
                                           Foreground="#9BB0CD"
                                           FontSize="12"/>
                                <TextBlock Text="Hash · Grafo"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- CONECTIVIDAD -->
                        <Border Grid.Column="2"
                                Background="#1C2B40"
                                CornerRadius="12"
                                Padding="17">
                            <StackPanel>
                                <TextBlock Text="Conectividad"
                                           Foreground="#9BB0CD"
                                           FontSize="12"/>
                                <TextBlock Text="Union-Find"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- GRAFO Y RUTAS -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- GRAFO DINÁMICO -->
                        <Border Grid.Column="0"
                                Background="#1B2A3F"
                                CornerRadius="13"
                                Padding="17"
                                Margin="0,0,12,0">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock
                                        Text="Visualización del grafo"
                                        FontSize="17"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Red dinámica de paradas y conexiones"
                                        Foreground="#96ABC8"
                                        FontSize="11"
                                        Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Reemplaza los 6 nodos fijos -->
                                <controles:GrafoControl
                                    x:Name="VisualizadorGrafo"
                                    Grid.Row="1"
                                    Margin="0,12,0,8"/>

                                <TextBlock Grid.Row="2"
                                           Text="Datos cargados desde paradas.csv y rutas.csv"
                                           Foreground="#91A6C4"
                                           FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- PANEL DE DIJKSTRA -->
                        <Border Grid.Column="1"
                                Background="#1B2A3F"
                                CornerRadius="13"
                                Padding="17">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- CONTROLES -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Calcular ruta"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,18"/>

                                    <TextBlock Text="Parada de origen"
                                               Foreground="#BCCDE1"
                                               FontSize="12"/>

                                    <ComboBox x:Name="CmbOrigen"
                                              Style="{StaticResource DarkCombo}"/>

                                    <TextBlock Text="Parada de destino"
                                               Foreground="#BCCDE1"
                                               FontSize="12"/>

                                    <ComboBox x:Name="CmbDestino"
                                              Style="{StaticResource DarkCombo}"/>

                                    <TextBlock
                                        Text="Criterio de optimización"
                                        Foreground="#BCCDE1"
                                        FontSize="12"
                                        Margin="0,4,0,9"/>

                                    <Grid Margin="0,0,0,17">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnTiempo"
                                                Grid.Column="0"
                                                Content="Tiempo"
                                                Tag="Tiempo"
                                                Background="#2865E8"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Height="39"
                                                Margin="0,0,5,0"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Click="Criterio_Click"/>

                                        <Button x:Name="BtnCosto"
                                                Grid.Column="1"
                                                Content="Costo"
                                                Tag="Costo"
                                                Background="#29394F"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Height="39"
                                                Margin="5,0,0,0"
                                                Cursor="Hand"
                                                Click="Criterio_Click"/>
                                    </Grid>

                                    <Button Content="Calcular ruta"
                                            Style="{StaticResource BlueButton}"
                                            Click="CalcularRuta_Click"/>
                                </StackPanel>

                                <!-- RESULTADOS CON SCROLL -->
                                <Border Grid.Row="1"
                                        Background="#152338"
                                        CornerRadius="9"
                                        Padding="12"
                                        Margin="0,15,0,0">

                                    <ScrollViewer
                                        x:Name="ScrollResultado"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">

                                        <TextBlock x:Name="TxtResultado"
                                                   Text="Resultado: pendiente"
                                                   Foreground="#B8CDE6"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- PÁGINAS SECUNDARIAS -->
                <Grid x:Name="SeccionView"
                      Visibility="Collapsed">

                    <!-- Aquí se muestran las pantallas reales -->
                    <ContentControl x:Name="ContenidoParadas"
                                    Visibility="Collapsed"/>

                    <!-- Pantalla provisional -->
                    <StackPanel x:Name="VistaPendiente"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="560">

                        <Border Width="74"
                                Height="74"
                                Background="#1D3A60"
                                CornerRadius="18"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,22">

                            <TextBlock Text="▤"
                                       Foreground="#7DB8FF"
                                       FontSize="41"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="TxtSeccionTitulo"
                                   Text="Sección"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>

                        <TextBlock x:Name="TxtSeccionDescripcion"
                                   Text="Selecciona una funcionalidad del sistema."
                                   Foreground="#AABBD0"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
