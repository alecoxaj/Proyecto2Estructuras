<UserControl x:Class="UrbanRoute.UI.Views.ParadasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="White"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- CAMPOS DE TEXTO -->
        <Style x:Key="CampoOscuro" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#253750"/>
            <Setter Property="BorderBrush" Value="#354E6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,11"/>
        </Style>

        <!-- BOTONES REDONDEADOS -->
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2865E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FondoBoton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FondoBoton"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FondoBoton"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ENCABEZADOS DE LA TABLA -->
        <Style x:Key="EncabezadoOscuro"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#263B56"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
        </Style>

        <!-- FILAS: PLANTILLA PROPIA SIN FONDO BLANCO -->
        <Style x:Key="FilaOscura" TargetType="DataGridRow">
            <Setter Property="Background" Value="#1B2A3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="FondoFila"
                                Background="#1B2A3F"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FondoFila"
                                        Property="Background"
                                        Value="#28569C"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver"
                                               Value="True"/>
                                    <Condition Property="IsSelected"
                                               Value="False"/>
                                </MultiTrigger.Conditions>

                                <Setter TargetName="FondoFila"
                                        Property="Background"
                                        Value="#304969"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CELDAS: CONTROL TOTAL DE LA SELECCIÓN -->
        <Style x:Key="CeldaOscura" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B2A3F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">

                        <Border x:Name="FondoCelda"
                                Background="#1B2A3F"
                                Padding="8,0"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Selección de fila azul oscuro -->
                            <DataTrigger
                                Binding="{Binding IsSelected,
                                RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                Value="True">
                                <Setter TargetName="FondoCelda"
                                        Property="Background"
                                        Value="#28569C"/>
                            </DataTrigger>

                            <!-- Selección directa de celda -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FondoCelda"
                                        Property="Background"
                                        Value="#28569C"/>
                            </Trigger>

                            <!-- Resaltado al pasar el cursor -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition
                                        Binding="{Binding IsMouseOver,
                                        RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                        Value="True"/>
                                    <Condition
                                        Binding="{Binding IsSelected,
                                        RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                        Value="False"/>
                                </MultiDataTrigger.Conditions>

                                <Setter TargetName="FondoCelda"
                                        Property="Background"
                                        Value="#304969"/>
                            </MultiDataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTO BLANCO DE LAS CELDAS -->
        <Style x:Key="TextoCelda" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

    </UserControl.Resources>

    <!-- DISTRIBUCIÓN PRINCIPAL -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Administración de paradas"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock
                Text="Registro, búsqueda y eliminación mediante Tabla Hash"
                Foreground="#9CB1CB"
                FontSize="12"
                Margin="0,6,0,0"/>
        </StackPanel>

        <!-- BUSCADOR Y ACCIONES -->
        <Grid Grid.Row="1" Margin="0,0,0,17">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtBuscar"
                     Grid.Column="0"
                     Style="{StaticResource CampoOscuro}"
                     Height="41"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"
                     ToolTip="Escribe un código como P001"/>

            <Button Grid.Column="1"
                    Content="Buscar"
                    Style="{StaticResource BotonAccion}"
                    Margin="0,0,9,0"
                    Click="Buscar_Click"/>

            <Button Grid.Column="2"
                    Content="Mostrar todas"
                    Style="{StaticResource BotonAccion}"
                    Background="#344860"
                    Margin="0,0,9,0"
                    Click="MostrarTodas_Click"/>

            <Button Grid.Column="3"
                    Content="Eliminar"
                    Style="{StaticResource BotonAccion}"
                    Background="#A53345"
                    Click="Eliminar_Click"/>
        </Grid>

        <!-- TABLA Y FORMULARIO -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL DE PARADAS -->
            <Border Grid.Column="0"
                    Background="#1B2A3F"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,12,0">

                <DockPanel LastChildFill="True">

                    <!-- Título y cantidad de registros -->
                    <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Paradas registradas"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock x:Name="TxtTotal"
                                   Grid.Column="1"
                                   Text="0 registros"
                                   FontSize="12"
                                   Foreground="#9BB4D2"/>
                    </Grid>

                    <!-- DATAGRID CORREGIDO -->
                    <DataGrid x:Name="TablaParadas"
                              Background="#1B2A3F"
                              Foreground="White"
                              RowBackground="#1B2A3F"
                              BorderThickness="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="None"
                              RowHeight="39"
                              ColumnHeaderHeight="38"
                              FontSize="12"
                              RowStyle="{StaticResource FilaOscura}"
                              CellStyle="{StaticResource CeldaOscura}"
                              ColumnHeaderStyle="{StaticResource EncabezadoOscuro}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Código"
                                Binding="{Binding Codigo}"
                                ElementStyle="{StaticResource TextoCelda}"
                                Width="0.8*"/>

                            <DataGridTextColumn
                                Header="Nombre"
                                Binding="{Binding Nombre}"
                                ElementStyle="{StaticResource TextoCelda}"
                                Width="1.7*"/>

                            <DataGridTextColumn
                                Header="Latitud"
                                Binding="{Binding Latitud}"
                                ElementStyle="{StaticResource TextoCelda}"
                                Width="1*"/>

                            <DataGridTextColumn
                                Header="Longitud"
                                Binding="{Binding Longitud}"
                                ElementStyle="{StaticResource TextoCelda}"
                                Width="1*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- FORMULARIO PARA AGREGAR -->
            <Border Grid.Column="1"
                    Background="#1B2A3F"
                    CornerRadius="12"
                    Padding="19">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Agregar nueva parada"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,17"/>

                        <TextBlock Text="Código único"
                                   Foreground="#B8CAE0"
                                   FontSize="12"/>

                        <TextBox x:Name="TxtCodigo"
                                 Style="{StaticResource CampoOscuro}"
                                 MaxLength="20"/>

                        <TextBlock Text="Nombre de la parada"
                                   Foreground="#B8CAE0"
                                   FontSize="12"/>

                        <TextBox x:Name="TxtNombre"
                                 Style="{StaticResource CampoOscuro}"/>

                        <TextBlock Text="Latitud"
                                   Foreground="#B8CAE0"
                                   FontSize="12"/>

                        <TextBox x:Name="TxtLatitud"
                                 Style="{StaticResource CampoOscuro}"
                                 ToolTip="Ejemplo: 14.8347"/>

                        <TextBlock Text="Longitud"
                                   Foreground="#B8CAE0"
                                   FontSize="12"/>

                        <TextBox x:Name="TxtLongitud"
                                 Style="{StaticResource CampoOscuro}"
                                 ToolTip="Ejemplo: -91.5180"/>

                        <Button Content="Agregar parada"
                                Style="{StaticResource BotonAccion}"
                                Height="44"
                                Margin="0,10,0,0"
                                Click="Agregar_Click"/>

                        <TextBlock
                            Text="Los registros se guardan en paradas.csv."
                            Foreground="#91A7C3"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MENSAJES DE ESTADO -->
        <TextBlock x:Name="TxtEstado"
                   Grid.Row="3"
                   Text="Selecciona una parada para eliminarla o registra una nueva."
                   Foreground="#A8BDD7"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"/>
    </Grid>
</UserControl>
