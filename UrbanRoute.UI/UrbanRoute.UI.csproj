<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencia al proyecto principal para tener acceso automático a TODAS las estructuras y modelos. -->
    <ProjectReference Include="..\Proyecto2Estructuras.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Incluye los archivos CSV iniciales para que se copien al ejecutar. -->
    <None Include="..\Datos\paradas.csv"
          Link="Datos\paradas.csv"
          CopyToOutputDirectory="PreserveNewest" />
          
    <None Include="..\Datos\rutas.csv"
          Link="Datos\rutas.csv"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>