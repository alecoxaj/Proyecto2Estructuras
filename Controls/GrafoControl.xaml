<UserControl x:Class="UrbanRoute.UI.Controls.GrafoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="GrafoControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Información de la red y controles de zoom -->
        <Grid Grid.Row="0" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtResumen"
                       Grid.Column="0"
                       Text="Cargando red..."
                       Foreground="#A7BFDB"
                       FontSize="11"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="−"
                        Width="29"
                        Height="28"
                        Margin="3,0"
                        Background="#304563"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Menos_Click"/>

                <Button Content="Ajustar"
                        Padding="9,0"
                        Height="28"
                        Margin="3,0"
                        Background="#304563"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Ajustar_Click"/>

                <Button Content="+"
                        Width="29"
                        Height="28"
                        Margin="3,0"
                        Background="#2865E8"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Mas_Click"/>
            </StackPanel>
        </Grid>

        <!-- Área del grafo con desplazamiento -->
        <Border Grid.Row="1"
                Background="#152338"
                CornerRadius="10"
                ClipToBounds="True">

            <ScrollViewer x:Name="ScrollGrafo"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="ScrollGrafo_SizeChanged">

                <Viewbox x:Name="EscalaVista"
                         Stretch="Uniform"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top">

                    <!-- Aquí se dibujarán los nodos y conexiones -->
                    <Canvas x:Name="Lienzo"
                            Width="1000"
                            Height="760"
                            Background="#152338"/>
                </Viewbox>

            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
